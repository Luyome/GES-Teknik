<?xml version="1.0" encoding="utf-8"?>
<!--
  GES Teknik — IIS reverse-proxy yapılandırması (PROJECT.md Bölüm 9, Faz 5).

  Yaklaşım: iisnode DEĞİL, ARR (Application Request Routing) reverse-proxy.
  Next.js (App Router, Node runtime, WebSocket tabanlı Neon adapter) `next
  start` ile arka planda ayrı bir Node process olarak çalışır (bkz.
  setup-iis.ps1 — bu process bir Windows servisi olarak NSSM ile kaydedilir).
  IIS, gelen 80/443 isteklerini bu process'in dinlediği yerel porta
  (varsayılan 3000) yönlendirir. Bu, iisnode'un Next.js'in kendi Node
  sunucusuyla (özellikle App Router + WebSocket bağımlılıkları) yaşadığı
  uyumluluk sürtünmesini önler.

  Bu dosya, `next build` çıktısının DEĞİL, IIS site kök dizininin
  (fiziksel yol) içine kopyalanmalıdır — setup-iis.ps1 bunu otomatik yapar.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="GES Teknik Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Next.js kendi Cache-Control: no-store header'ını (next.config.ts)
         zaten gönderiyor; IIS statik dosya önbelleğinin bunu ezmediğinden
         emin olunmalı (ARR proxy modunda statik dosya işleyicisi devre
         dışıdır, bu yüzden ek bir ayar gerekmez). -->
  </system.webServer>
</configuration>
